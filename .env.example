# Required: pooled PostgreSQL connection used by the running application.
# Supabase: use the Transaction pooler URI and keep its SSL parameters.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connection_limit=1&pool_timeout=15&connect_timeout=10"

# Required: direct/session PostgreSQL connection used by Prisma migrations and the persistent local development server.
# This must not use the transaction-pooler port. Supabase normally provides port 5432.
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=1&connect_timeout=10"

# Required: signs administrator sessions. Use at least 32 random characters.
# PowerShell example: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
AUTH_SECRET="replace-with-a-unique-random-secret-of-at-least-32-characters"

# Required in production: canonical public origin, without a trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Required only for `npm run db:seed`; remove these from the environment after seeding.
# Alternatively, do not set them and use:
# npm run admin:create -- your-admin@example.com "replace-with-a-strong-password"
# SEED_ADMIN_EMAIL="your-admin@example.com"
# SEED_ADMIN_PASSWORD="replace-with-a-strong-password-of-at-least-12-characters"